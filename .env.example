NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only, write-capable token. Never expose this in a NEXT_PUBLIC variable.
SANITY_API_WRITE_TOKEN=
# Match this to the Sanity webhook's Secret field.
SANITY_REVALIDATE_SECRET=
# Stable random key for opaque form/rate-limit IDs.
FORM_ID_SECRET=
SITE_URL=https://www.sportoid.com
